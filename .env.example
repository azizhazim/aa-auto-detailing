# Resend API key — get yours at https://resend.com/api-keys
# Required for /api/book to send booking emails.
RESEND_API_KEY=

# Email address that receives booking submissions.
BOOKING_TO_EMAIL=610aaautodetailing@gmail.com

# "From" address shown on outgoing emails.
# Until anaautodetailing.com is verified in Resend, use the sandbox sender below.
# After domain verification, switch to e.g. "Bookings <bookings@anaautodetailing.com>".
BOOKING_FROM_EMAIL="A&A Booking <onboarding@resend.dev>"
